{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"remote-b2b-sce": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss"
				}
			},
			"root": "projects/remote-b2b-sce",
			"sourceRoot": "projects/remote-b2b-sce/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "ngx-build-plus:browser",
					"options": {
						"outputPath": "dist/remote-b2b-sce",
						"index": "projects/remote-b2b-sce/src/index.html",
						"main": "projects/remote-b2b-sce/src/main.ts",
						"polyfills": [
							"zone.js"
						],
						"tsConfig": "projects/remote-b2b-sce/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							"projects/remote-b2b-sce/src/favicon.ico",
							"projects/remote-b2b-sce/src/assets"
						],
						"styles": [
							"projects/remote-b2b-sce/src/styles.scss"
						],
						"scripts": [],
						"extraWebpackConfig": "projects/remote-b2b-sce/webpack.config.js",
						"commonChunk": false
					},
					"configurations": {
						"prod": {
							"fileReplacements": [
								{
								"replace": "projects/remote-b2b-sce/src/environments/environment.ts",								
								"with": "projects/remote-b2b-sce/src/environments/environment.ts"								
								}
							],
							"optimization": true,
							"sourceMap": false,
							"extractLicenses": true,
							"vendorChunk": true,
							"buildOptimizer": true,
							"namedChunks": false,
							"commonChunk": true,
							"aot": true,
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kb",
									"maximumError": "1mb"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "2kb",
									"maximumError": "16kb"
								}
							],
							"outputHashing": "all",
							"extraWebpackConfig": "projects/remote-b2b-sce/webpack.prod.config.js"
						}
					},
					"defaultConfiguration": "prod"
				},
				"serve": {
					"builder": "ngx-build-plus:dev-server",
					"configurations": {
						"prod": {
							"browserTarget": "remote-b2b-sce:build:prod",
							"extraWebpackConfig": "projects/remote-b2b-sce/webpack.prod.config.js"
						},
						"development": {
							"browserTarget": "remote-b2b-sce:build:development",
							"extraWebpackConfig": "projects/remote-b2b-sce/webpack.prod.config.js"
						}
					},
					"defaultConfiguration": "prod",
					"options": {
						"port": 4300,
						"publicHost": "http://localhost:4300",
						"extraWebpackConfig": "projects/remote-b2b-sce/webpack.config.js"
					}
				},
				"extract-i18n": {
					"builder": "ngx-build-plus:extract-i18n",
					"options": {
						"browserTarget": "remote-b2b-sce:build",
						"extraWebpackConfig": "projects/remote-b2b-sce/webpack.config.js"
					}
				},
				"test": {
					"builder": "@angular-devkit/build-angular:karma",
					"options": {
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						],
						"tsConfig": "projects/remote-b2b-sce/tsconfig.spec.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							"projects/remote-b2b-sce/src/favicon.ico",
							"projects/remote-b2b-sce/src/assets"
						],
						"styles": [
							"projects/remote-b2b-sce/src/styles.scss"
						],
						"scripts": []
					}
				}
			}
		}
  },
  "cli": {
    "analytics": false
  }
}
